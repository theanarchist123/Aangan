# services/api
DATABASE_URL=sqlite+aiosqlite:///./aangan.db
LLM_PROVIDER=mock                # mock (offline, no keys) | gemini | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
SIGNING_SECRET=change-me-in-production
REQUIRE_SIGNATURE=false          # true = approvals need an Ed25519 signature from the registered phone
CORS_ORIGINS=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8000

# WhatsApp Cloud API (see README "WhatsApp setup")
WHATSAPP_VERIFY_TOKEN=           # any string you invent; paste the same value into Meta's webhook settings
WHATSAPP_APP_SECRET=             # Meta app secret: used to verify X-Hub-Signature-256
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SARVAM_API_KEY=                  # voice-note transcription (Hindi, Marathi, Tamil, ...)

# Supabase: auth, database, storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # backend only. Never in the web or mobile app
SUPABASE_DB_PASSWORD=            # used only by migration scripts
WHATSAPP_ALLOWED_RECIPIENTS=     # test-mode safety: comma-separated 10-digit numbers; empty = no restriction
GUARDIAN_INTERVAL_MINUTES=60
ENABLE_DEV_ENDPOINTS=false       # must stay false outside tests
